{
  "doctype": "DocType",
  "name": "Teamspace Push Subscription",
  "module": "Snrg Credit Control",
  "issingle": 0,
  "engine": "InnoDB",
  "field_order": [
    "user",
    "subscription",
    "enabled",
    "last_delivered_on",
    "last_status"
  ],
  "fields": [
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "options": "User",
      "label": "User",
      "reqd": 1
    },
    {
      "fieldname": "subscription",
      "fieldtype": "Password",
      "label": "Encrypted subscription",
      "hidden": 1,
      "reqd": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1"
    },
    {
      "fieldname": "last_delivered_on",
      "fieldtype": "Datetime",
      "label": "Last accepted by push service",
      "read_only": 1
    },
    {
      "fieldname": "last_status",
      "fieldtype": "Data",
      "label": "Last delivery status",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "autoname": "prompt"
}
